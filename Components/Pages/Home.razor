    </section>

    @* ── Footer ── *@
    <footer class="landing__footer">
        <div class="landing__footer-inner">
            <div class="landing__footer-brand">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
                    <circle cx="16" cy="16" r="15" fill="hsl(268, 62%, 58%)" opacity="0.15"/>
                    <circle cx="16" cy="16" r="10" fill="hsl(268, 62%, 58%)" opacity="0.3"/>
                    <circle cx="16" cy="16" r="5"  fill="hsl(268, 62%, 58%)"/>
                </svg>
                <span>Alectrone</span>
            </div>
            @* In-page destinations and a mail link only. The demo serves one
               route, so /privacy, /terms, /cookies and every /Account/* link
