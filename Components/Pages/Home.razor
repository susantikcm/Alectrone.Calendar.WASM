</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // The most seats any self-serve business plan can hold, which is the whole
    // instrument the #modes seat rule draws. MIRRORS the single source of truth,
    // CalendarPlans.BusinessSeatCeiling in Alectrone.Calendar.Web/Services/
    // CalendarPlans.cs; it is restated rather than referenced because that
    // catalog lives inside the Web host and this demo ships no plan model.
    // If the ceiling ever moves there, move it here too.
    private const int SeatCeiling = 300;

    private static readonly string[] _monthAbbrevs = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    private static readonly int[] _cwDotDays = { 3, 8, 15, 24 };

    // A category color per view-mock event, kept to the four-color palette
    // (purple / blue / green / amber) the landing mocks established. Time is
    // optional: only tall enough chips carry a start time (short blocks show
    // just the title, the way a real week column ellipsises a busy day).
    private readonly record struct Blk(string Name, string C, int T, int H, string? Time = null);

    // ── Scene 6c · the two account shapes ─────────────────────────────────
    // One word in a shape field. Lead words are the tier's headline capability
    // and carry display weight; the rest are the quieter second tier. X and Y
    // are percentages of the field box: the fields are hand-composed staggered
    // two-column drifts, not a random cloud, and collapse to a wrapped flow
    // below the pin breakpoint.
    private readonly record struct ShapeWord(string Text, bool Lead, double X, double Y);

    // Ticked for Free or Individual in the comparison matrix, so a personal
    // account already carries them. "Seven views" is the SchedulerView count the
    // proof scene states; the rest are matrix rows or CalendarPlans facts.
    private static readonly ShapeWord[] _personalWords =
    [
        new("Booking pages", true, 1, 0),
        new("Availability", true, 62, 3),
        new("Seven views", true, 6, 21),
        new("Stripe payments", true, 52, 25),
        new("Google & 365 sync", true, 0, 42),
        new("Reminders", false, 66, 47),
        new("Buffer times", false, 10, 64),
        new("Recurring events", false, 56, 68),
        new("Field encryption", false, 3, 85),
    ];

    // Absent from BOTH personal plans in the matrix and present in the business
    // lane: these are the capabilities an organization adds, not a paywall on
    // your own calendar.
    private static readonly ShapeWord[] _workspaceWords =
    [
        new("Admin console", true, 1, 0),
        new("Members & seats", true, 56, 3),
        new("Roles & access", true, 7, 21),
        new("Integrations", true, 64, 25),
        new("Webhooks", true, 0, 42),
        new("Shared calendars", false, 60, 47),
        new("Round-robin", false, 10, 64),
        new("Resources & rooms", false, 58, 68),
        new("REST API", false, 3, 85),
        new("Booking analytics", false, 52, 89),
    ];

    // ── Scene 6b · the assistant's week ───────────────────────────────────
    // Nine hours (09:00-18:00) of one work week: the commitments the assistant
    // reads before it answers. The scene's claim is that it books the asked-for
    // hour ONCE it knows the hour is clear, so Friday 12:00-13:00 is drawn as
    // the one gap the sentence lands in; the rest of the week is deliberately
    // not clear. Start / End are decimal hours and the CSS positions every
    // block as a fraction of the window, so the drawing stays true to scale.
    private const double AiDayStart = 9, AiDayEnd = 18;
    private const double AiHitStart = 12, AiHitEnd = 13;
    private const int AiHitDay = 4; // Friday, the day the sentence names

    private readonly record struct AiBusy(double Start, double End);
    private readonly record struct AiField(string Key, string Value);

    private static readonly string[] _aiDays = { "Mon", "Tue", "Wed", "Thu", "Fri" };
    private static readonly double[] _aiHourMarks = { 9, 11, 13, 15, 17 };

    // What the sentence resolves to. These are the four things an event needs,
    // read straight out of "Lunch with Maya on Friday at noon".
    private static readonly AiField[] _aiFields =
    [
        new("Title", "Lunch with Maya"),
        new("Day", "Friday"),
        new("Start", "12:00"),
        new("Length", "1 hour"),
    ];

    private static readonly AiBusy[][] _aiWeek =
    [
        [new(9.5, 11), new(13, 14.5)],
        [new(9, 10.5), new(11.5, 13), new(15.5, 17)],
        [new(10, 12), new(14, 15)],
        [new(9, 10.5), new(12.5, 14), new(16, 17.5)],
        [new(9.5, 11.5), new(14, 15.5)],
    ];

    // Position (0..1) of an hour in the drawn window, and the height of a span.
    private static string AiAt(double hour) =>
        ((hour - AiDayStart) / (AiDayEnd - AiDayStart)).ToString("0.####", Inv);

    private static string AiSpan(double from, double to) =>
        ((to - from) / (AiDayEnd - AiDayStart)).ToString("0.####", Inv);

    private static string AiClock(double hour) =>
        ((int)hour).ToString("00", Inv) + ":" + ((int)((hour % 1) * 60)).ToString("00", Inv);

    private string _monthLabel = "";
    private string _bookingDayLabel = "";
    private string _cwDayLabel = "";
    private string _cwMonthLabel = "";
    private int _currentMonthIndex;
    private int _cwDay;

    // ── View-strip mock date model. Server-rendered so the no-JS pose is
    //    calendar-true; landing-scenes.js re-derives every [data-td*] slot
    //    from the visitor's OWN clock on load, so the preview always shows
    //    the viewer's local day / date / month / year. ──────────────────────
    private DateTime _today;
    private string _dayDow = "", _dayNum = "", _dayMon = "", _nowPct = "0";
    // Hero time-dial hand angles (degrees clockwise from 12), decorative.
    private string _clockHour = "0", _clockMin = "0";
    private DateTime[] _weekDays = System.Array.Empty<DateTime>();
    private DateTime[] _monthCells = System.Array.Empty<DateTime>();
    private int _monthNumber;
    private static readonly int[] _monthDotDays = { 3, 8, 15, 24 };
    private static readonly string[] _dotPalette =
        { "hsl(268, 60%, 58%)", "hsl(220, 70%, 58%)", "hsl(160, 60%, 45%)", "hsl(38, 80%, 55%)" };
    private string _yearLabel = "";
    private string _tlDate = "";
    private string _tlNowPct = "0";
    private List<Blk>[] _weekBlocks = System.Array.Empty<List<Blk>>();
    private List<Blk>[] _wweekBlocks = System.Array.Empty<List<Blk>>();

    // Year view: for each month of the current year, the Monday-start leading
    // blank count and the day count, so each mini renders a real month grid
    // (correct first-weekday offset). Today is lit only in the current month.
    private readonly record struct MonthShape(int Lead, int Days);
    private MonthShape[] _yearMonths = System.Array.Empty<MonthShape>();
    private int _todayDay;

    private string DotColor(int day)
    {
        var i = System.Array.IndexOf(_monthDotDays, day);
        return _dotPalette[(i < 0 ? 0 : i) % _dotPalette.Length];
    }

    private string RelLabel(int off) => off switch
    {
        0 => "Today",
        1 => "Tomorrow",
        _ => _today.AddDays(off).ToString("ddd", Inv),
    };

    // Absolute date beside each agenda group heading (re-derived client-side
    // from [data-td-reldate] so it always matches the visitor's local clock).
    private string RelDate(int off) => _today.AddDays(off).ToString("MMM d", Inv);

    protected override void OnInitialized()
    {
        // On WebAssembly DateTime.Now is already the VISITOR's clock, so the
        // mocks below are calendar-true on first paint and landing-scenes.js's
        // localizeToday() only re-derives the same values. (In the Web host
        // this runs on the server and the localizer is what makes the preview
        // local.) Invariant culture keeps the English month and day names the
        // mocks assume, whatever locale the browser reports.
        var now = DateTime.Now;
        var today = now.Date;
        _today = today;

        // Day view header + "now" line (window 07:00-21:00).
        _dayDow = today.ToString("ddd", Inv);
        _dayNum = today.Day.ToString(Inv);
        _dayMon = today.ToString("MMM", Inv);
        var nowP = System.Math.Clamp((now.TimeOfDay.TotalHours - 7.0) / 14.0, 0, 1) * 100.0;
        _nowPct = nowP.ToString("0.#", Inv);

        // Hero time-dial: hands set to the real current time (decorative, aria-hidden).
        var hour12 = now.Hour % 12;
        _clockHour = (hour12 * 30 + now.Minute * 0.5).ToString("0.##", Inv);
        _clockMin = (now.Minute * 6).ToString("0.##", Inv);

        // Week / work week: this week's Monday-start run of days.
        var mondayBack = ((int)today.DayOfWeek + 6) % 7;
        var weekStart = today.AddDays(-mondayBack);
        _weekDays = new DateTime[7];
        for (var i = 0; i < 7; i++) _weekDays[i] = weekStart.AddDays(i);

        // Month: a Monday-start 6x7 grid over the current month.
        var firstOfMonth = new DateTime(today.Year, today.Month, 1);
        var gridBack = ((int)firstOfMonth.DayOfWeek + 6) % 7;
        var gridStart = firstOfMonth.AddDays(-gridBack);
        _monthCells = new DateTime[42];
        for (var i = 0; i < 42; i++) _monthCells[i] = gridStart.AddDays(i);
        _monthNumber = today.Month;

        _currentMonthIndex = today.Month - 1;
        _todayDay = today.Day;
        _monthLabel = today.ToString("MMMM yyyy", Inv);
        _yearLabel = today.Year.ToString(Inv);
        _tlDate = today.ToString("ddd d MMM", Inv);

        // Year minis: real per-month shape (Monday-start offset + day count).
        _yearMonths = new MonthShape[12];
        for (var m = 0; m < 12; m++)
        {
            var first = new DateTime(today.Year, m + 1, 1);
            var lead = ((int)first.DayOfWeek + 6) % 7; // Mon = 0
            _yearMonths[m] = new MonthShape(lead, DateTime.DaysInMonth(today.Year, m + 1));
        }

        // Timeline "now" marker across the 9a-5p axis window.
        var tlP = System.Math.Clamp((now.TimeOfDay.TotalHours - 9.0) / 8.0, 0, 1) * 100.0;
        _tlNowPct = tlP.ToString("0.#", Inv);

        // The same team's week, read every way: the mocks below echo the hero
        // and schedule scenes so the seven views tell one coherent story. Tall
        // chips carry a start time; short ones stay title-only.
        _weekBlocks = new[]
        {
            new List<Blk> { new("Design review", _dotPalette[0], 12, 26, "9:00"), new("Standup", _dotPalette[1], 72, 12) },
            new List<Blk> { new("Deep work", _dotPalette[1], 8, 24, "8:00"), new("Sprint", _dotPalette[2], 54, 24, "11:30") },
            new List<Blk> { new("1:1 · Sam", _dotPalette[2], 34, 16) },
            new List<Blk> { new("Roadmap", _dotPalette[3], 12, 18, "9:00"), new("Demo", _dotPalette[1], 56, 26, "13:00") },
            new List<Blk> { new("Retro", _dotPalette[0], 20, 18, "10:00"), new("Office hrs", _dotPalette[2], 70, 14) },
            new List<Blk>(),
            new List<Blk> { new("Brunch", _dotPalette[3], 30, 14) },
        };
        _wweekBlocks = new[]
        {
            new List<Blk> { new("Design review", _dotPalette[0], 12, 24, "9:00") },
            new List<Blk> { new("Deep work", _dotPalette[1], 8, 20, "8:00"), new("Sprint", _dotPalette[2], 56, 22, "11:30") },
            new List<Blk> { new("1:1 · Sam", _dotPalette[2], 30, 16), new("Design crit", _dotPalette[3], 60, 20, "14:30") },
            new List<Blk> { new("Roadmap", _dotPalette[3], 14, 18, "9:00"), new("Demo", _dotPalette[1], 54, 24, "13:00") },
            new List<Blk> { new("Retro", _dotPalette[0], 26, 18, "10:00") },
        };

        var daysToTuesday = ((int)DayOfWeek.Tuesday - (int)today.DayOfWeek + 7) % 7;
        if (daysToTuesday == 0) daysToTuesday = 7;
        var bookingDate = today.AddDays(daysToTuesday);
        _bookingDayLabel = bookingDate.ToString("dddd, MMMM d", Inv);
        // The colorway vignette shows a stylized 28-cell month labeled with
        // the booking date's month, so "Tuesday N" is always calendar-true;
        // clamp so the highlighted day always exists in the grid.
        _cwDay = Math.Min(bookingDate.Day, 28);
        _cwDayLabel = "Tuesday " + _cwDay;
        _cwMonthLabel = bookingDate.ToString("MMMM yyyy", Inv);
    }

    // ── Scene engine ──────────────────────────────────────────────────────
    // Imported and armed on first render, when the landing root is guaranteed
    // to be in the DOM. init() is idempotent (it destroys any previous run
    // first) and the engine only flips state classes, publishes custom
    // properties, and writes textContent on aria-hidden mock nodes: it never
    // inserts, moves or removes a node, so it cannot fight the renderer.
    //
    // Every failure here is swallowed on purpose. The engine is enhancement:
    // without it the base CSS still renders every scene in its composed final
    // pose, so a blocked or missing module costs the motion, not the page.
    private IJSObjectReference? _motion;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _motion = await JS.InvokeAsync<IJSObjectReference>("import", "./js/landing-scenes.js");
            await _motion.InvokeVoidAsync("init", "calendar-landing");
        }
        catch (JSException)
        {
            // Module failed to load or threw while arming: keep the static pose.
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-import.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_motion is null) return;
        try
        {
            await _motion.InvokeVoidAsync("destroy");
            await _motion.DisposeAsync();
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (OperationCanceledException) { }
        finally
        {
            _motion = null;
        }
    }
}
