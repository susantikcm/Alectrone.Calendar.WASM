            <div class="landing__footer-links">
                <div class="landing__footer-col">
                    <h4>Product</h4>
                    <a href="#schedule">Team scheduling</a>
                    <a href="#views">Calendar views</a>
                    <a href="#booking">Booking pages</a>
                </div>
                <div class="landing__footer-col">
                    <h4>More</h4>
                    <a href="#colorways">Colorways</a>
                    <a href="#modes">Personal or Workspace</a>
                    <a href="#ai">AI assistant</a>
                    <a href="mailto:sales@alectrone.com">Email sales</a>
                </div>
                <div class="landing__footer-col">
                    <h4>About this build</h4>
                    <span class="landing__footer-note">Blazor WebAssembly demo</span>
                    <span class="landing__footer-note">Homepage only</span>
                    <span class="landing__footer-note">No account required</span>
